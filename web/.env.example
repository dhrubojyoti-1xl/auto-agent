# =============================================================================
# auto-agent web — environment
# =============================================================================
# Copy to .env.local for local development. Set the same keys in the Vercel
# dashboard for production. Never commit real values.
# =============================================================================

# Supabase Postgres. Use the CONNECTION POOLER string (port 6543), not the
# direct 5432 one — Vercel runs each request in its own isolate and will
# exhaust a direct connection pool.
# Supabase dashboard -> Project Settings -> Database -> Connection pooling
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Password your team types to sign in. Any strong passphrase.
APP_PASSWORD=

# Signs the session cookie. At least 16 characters of randomness:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Bearer token for POST /api/ingest, used by the Apps Script Gmail bridge.
# Generate the same way as SESSION_SECRET. Optional — leave blank to disable
# machine ingest entirely.
INGEST_TOKEN=

# Optional. Without it the system runs fully; reports are generated from the
# deterministic layer and say so.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional engine overrides
SLOW_TASK_MULTIPLIER=1.5
DATE_ORDER=DMY
